include .editorconfig .gitattributes .gitignore .release-files AGENTS.md
include CHANGELOG.md SECURITY.md start.sh package.json requirements*.txt
include .github/workflows/test.yml
recursive-include deploy *.service
recursive-include docs *.md *.png
recursive-include examples *.yaml
recursive-include scripts *.py *.sh
recursive-include tests *.py *.mjs *.json
